{
  "manifest_version": 3,
  "name": "Agent Blindfold",
  "version": "0.1.0",
  "description": "Lets Agent Blindfold find and fill login boxes in a tab of this Chrome with what you entered on its one-time page.",
  "minimum_chrome_version": "126",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["alarms", "nativeMessaging", "scripting", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" }
}
